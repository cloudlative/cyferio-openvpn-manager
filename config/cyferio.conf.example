# Cyferio OpenVPN Manager — configuration
#
# Copied to /etc/cyferio/cyferio.conf on install. Lines are KEY=VALUE;
# comments start with #. Only the keys listed below are recognized —
# config.sh rejects unknown keys rather than silently ignoring typos.

# OpenVPN listening port
vpn_port=1194

# OpenVPN protocol: udp | tcp
vpn_proto=udp

# VPN subnet handed to clients
vpn_subnet=10.8.0.0
vpn_subnet_mask=255.255.255.0

# Public hostname or IP clients should connect to, embedded into every
# exported .ovpn profile. Leave unset to auto-detect the host's public IP
# at profile-export time (fine for a single static IP; set this
# explicitly if you have a DNS name, a floating/failover IP, or the
# instance's IP can change).
vpn_public_endpoint=

# MAC enforcement mode: strict | permissive
# Only applies to a user who already has at least one MAC registered —
# governs what happens if their connecting client fails to report a MAC
# at all (not a mismatch, an absence):
# strict     — reject the connection (default)
# permissive — allow it anyway, but still log it, useful during initial
#              rollout before every client is confirmed to report peer-info
mac_enforcement_mode=strict

# Require every user to have at least one MAC registered before they can
# connect at all: true | false (default false — MAC binding is opt-in
# per user; a user with zero MACs registered connects unrestricted from
# any device). Set true to make registration itself mandatory. This is
# independent of mac_enforcement_mode above, which only governs
# already-registered users whose client doesn't report a MAC.
mac_required=false

# Default output format for reporting commands: table | json | plain
default_output_format=table
